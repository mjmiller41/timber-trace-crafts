# Production secrets ship via .env.production.encrypted (committed to git,
# safe to read) — never commit .env or .env.production directly. To update
# production values: edit a local .env.production (gitignored), then run
# `php artisan env:encrypt --env=production --key=<key>` and commit the
# resulting .env.production.encrypted. deploy.sh decrypts it into .env on
# the server using a key file that lives outside the repo. See
# memory/project_infra.md for the full workflow and key location.

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_ENV=production even if unset; only set this to
# override that default (e.g. force false while testing HTTPS locally).
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=r2

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=timber-trace-crafts
R2_ENDPOINT=
R2_PUBLIC_URL=

# Used by db:export-hostinger / db:import-hostinger; override with CLI options if unset.
HOSTINGER_DB_HOST=
HOSTINGER_DB_PORT=3306
HOSTINGER_DB_DATABASE=
HOSTINGER_DB_USERNAME=
HOSTINGER_DB_PASSWORD=

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=hello@timbertracecrafts.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@timbertracecrafts.com"
MAIL_FROM_NAME="Timber Trace Crafts"

IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USERNAME=hello@timbertracecrafts.com
IMAP_PASSWORD=
IMAP_NOVALIDATE_CERT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe Payments
STRIPE_KEY=pk_test_
STRIPE_SECRET=sk_test_
STRIPE_WEBHOOK_SECRET=

# Google reCAPTCHA v3 (login, contact, checkout). Leave blank to soft-disable —
# forms fall back to the honeypot field only. Get keys at
# https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Sender.net (Phase 2)
SENDER_API_KEY=

# Analytics — Umami (client-side, privacy-respecting, cookieless).
# Tracker renders only when UMAMI_WEBSITE_ID is set. SCRIPT_URL defaults to
# Umami Cloud; override for a self-hosted instance. DOMAINS scopes tracking.
UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
UMAMI_WEBSITE_ID=
UMAMI_DOMAINS=timbertracecrafts.com

# Server-side funnel events (first-party, ad-blocker-proof) → storage/logs/analytics.log
ANALYTICS_SERVER_EVENTS=true
ANALYTICS_LOG_DAYS=90

ETSY_KEYSTRING=your-etsy-keystring
ETSY_SHARED_SECRET=your-etsy-shared-secret
ETSY_WEBHOOK_SECRET=your-etsy-webhook-secret
# Set to your ngrok URL during local dev: https://xxxx.ngrok.io/admin/etsy/callback
ETSY_REDIRECT_URI=
# Klaviyo (newsletter signup -> welcome flow)
KLAVIYO_PRIVATE_KEY=
KLAVIYO_NEWSLETTER_LIST_ID=
